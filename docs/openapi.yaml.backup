      operationId: adminCreateForum
      security:
        - cookieAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [slug, status, startsAt, qrExpiresAt, capacity, translations]
              properties:
                slug:
                  type: string
                status:
                  $ref: '#/components/schemas/ForumStatus'
                startsAt:
                  $ref: '#/components/schemas/DateTime'
                qrExpiresAt:
                  $ref: '#/components/schemas/DateTime'
                capacity:
                  type: integer
                translations:
                  type: array
                  items:
                    type: object
      responses:
        '201':
          description: Forum created
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forum'
  
  /admin/forums/{forumId}:
    get:
      summary: Get forum details
