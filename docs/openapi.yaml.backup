              schema:
                type: object
                properties:
                  success:
                    type: boolean
  
  # ========================================
  # Admin - Reports (5 endpoints)
  # ========================================
  
  /admin/reports/revenue:
    get:
      summary: Revenue report
      tags: [Admin]
      operationId: adminGetRevenueReport
      security:
        - cookieAuth: []
      parameters:
        - name: startDate
          in: query
          schema:
            $ref: '#/components/schemas/DateTime'
        - name: endDate
          in: query
          schema:
            $ref: '#/components/schemas/DateTime'
        - name: forumId
          in: query
          schema:
            $ref: '#/components/schemas/UUID'
      responses:
        '200':
          description: Revenue data
          content:
            application/json:
              schema:
                type: object
                properties:
                  totalRevenue:
                    type: integer
                  orderCount:
                    type: integer
                  averageOrderValue:
                    type: number
  
  /admin/reports/sales:
    get:
      summary: Sales report
      tags: [Admin]
      operationId: adminGetSalesReport
      security:
        - cookieAuth: []
      parameters:
        - name: forumId
          in: query
          schema:
            $ref: '#/components/schemas/UUID'
      responses:
        '200':
          description: Sales data
          content:
            application/json:
              schema:
                type: object
                properties:
                  ticketsSold:
                    type: integer
                  capacity:
                    type: integer
                  salesRate:
                    type: number
  
  /admin/reports/users:
    get:
      summary: User statistics
      tags: [Admin]
      operationId: adminGetUserReport
      security:
        - cookieAuth: []
      responses:
        '200':
          description: User stats
          content:
            application/json:
              schema:
                type: object
                properties:
                  totalUsers:
                    type: integer
                  activeUsers:
                    type: integer
  
  /admin/reports/forums:
    get:
      summary: Forum statistics
      tags: [Admin]
      operationId: adminGetForumReport
      security:
        - cookieAuth: []
      responses:
        '200':
          description: Forum stats
          content:
            application/json:
              schema:
                type: object
                properties:
                  totalForums:
                    type: integer
                  publishedForums:
                    type: integer
  
  /admin/reports/export:
    post:
      summary: Export custom report
      tags: [Admin]
      operationId: adminExportReport
      security:
        - cookieAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [reportType]
              properties:
                reportType:
                  type: string
                  enum: [orders, tickets, revenue, users]
                format:
                  type: string
                  enum: [csv, xlsx]
                  default: csv
                filters:
                  type: object
      responses:
        '200':
          description: Report file
          content:
            text/csv:
              schema:
                type: string
                format: binary
  
  # ========================================
  # Admin - Audit Logs (2 endpoints)
  # ========================================
  
  /admin/audit-logs:
    get:
      summary: List audit logs
      tags: [Admin]
      operationId: adminListAuditLogs
      security:
        - cookieAuth: []
      parameters:
        - name: page
          in: query
          schema:
            type: integer
            default: 1
        - name: limit
          in: query
          schema:
            type: integer
            default: 50
        - name: userId
          in: query
          schema:
            $ref: '#/components/schemas/UUID'
        - name: action
          in: query
          schema:
            type: string
      responses:
        '200':
          description: Audit log list
          content:
            application/json:
              schema:
                type: object
                properties:
                  logs:
                    type: array
                    items:
                      type: object
                      properties:
                        id:
                          $ref: '#/components/schemas/UUID'
                        userId:
                          $ref: '#/components/schemas/UUID'
                        action:
                          type: string
                        targetType:
                          type: string
                        targetId:
                          $ref: '#/components/schemas/UUID'
                        metadata:
                          type: object
                        createdAt:
                          $ref: '#/components/schemas/DateTime'
                  pagination:
                    $ref: '#/components/schemas/Pagination'
  
  /admin/audit-logs/export:
    get:
      summary: Export audit logs
      tags: [Admin]
      operationId: adminExportAuditLogs
      security:
        - cookieAuth: []
      parameters:
        - name: startDate
          in: query
          schema:
            $ref: '#/components/schemas/DateTime'
        - name: endDate
          in: query
          schema:
            $ref: '#/components/schemas/DateTime'
      responses:
        '200':
          description: CSV file
          content:
            text/csv:
              schema:
                type: string
                format: binary
