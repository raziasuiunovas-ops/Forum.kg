          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Forum'
    
    delete:
      summary: Delete forum
      tags: [Admin]
      operationId: adminDeleteForum
      security:
        - cookieAuth: []
      parameters:
        - name: forumId
          in: path
          required: true
          schema:
            $ref: '#/components/schemas/UUID'
      responses:
        '200':
          description: Deleted
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
  
  /admin/forums/{forumId}/publish:
    post:
