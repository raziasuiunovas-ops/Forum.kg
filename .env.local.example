# Application
NEXT_PUBLIC_APP_NAME=Forum
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/forum_db

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-change-this

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@forum.com

# File Upload & S3 Storage
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./public/uploads
AWS_ENDPOINT_URL_S3=https://your-bucket.storage.region.aws.neon.tech
AWS_ACCESS_KEY_ID=your-neon-access-key
AWS_SECRET_ACCESS_KEY=your-neon-secret-key
AWS_REGION=us-east-2
AWS_S3_PRIVATE_BUCKET=forum-uploads

# Environment
NODE_ENV=development
