# Server
PORT=5000
NODE_ENV=development

# Database - Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require&channel_binding=require"

# Finik Payment Gateway
FINIK_ENV=beta
FINIK_API_KEY=your_finik_api_key
FINIK_ACCOUNT_ID=your_finik_account_id
FINIK_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
YOUR_FINIK_PRIVATE_KEY_HERE
-----END PRIVATE KEY-----"
FINIK_BETA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
YOUR_FINIK_BETA_WEBHOOK_PUBLIC_KEY_HERE
-----END PUBLIC KEY-----"
FINIK_PROD_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
YOUR_FINIK_PROD_WEBHOOK_PUBLIC_KEY_HERE
-----END PUBLIC KEY-----"
FINIK_REDIRECT_URL=https://your-domain.example/payment/return
FINIK_WEBHOOK_URL=https://your-domain.example/api/v1/payments/webhooks/finik

# Authentication & JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
SESSION_SECRET=your-session-secret-key

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@forum.com

# File Upload & Storage
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Neon Object Storage (S3-compatible). Configure this bucket as private.
AWS_S3_PRIVATE_BUCKET=your-private-upload-bucket
AWS_ENDPOINT_URL_S3="https://your-storage-endpoint.storage.neon.tech"
AWS_ACCESS_KEY_ID=your_neon_access_key_id
AWS_SECRET_ACCESS_KEY=your_neon_secret_access_key
AWS_REGION=us-east-2

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000

# CORS
CORS_ORIGIN=http://localhost:3000

# Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_BOT_ID=YOUR_BOT_ID
TELEGRAM_BOT_USERNAME=your_bot_username

# QR Encryption (keep this key outside the database and secret management protected)
QR_ENCRYPTION_KEY="REPLACE_WITH_SECURE_SECRET_FROM_SECRET_MANAGER"

# QR Token Encryption - AES-256-GCM
# Generate with: openssl rand -base64 32
# SECURITY: Rotate periodically, store in secure vault (AWS Secrets Manager, Azure Key Vault, etc.)
# WARNING: Changing this key will invalidate all existing QR codes in database
ENCRYPTION_KEY_BASE64=your_256_bit_encryption_key_base64_encoded_here

# Admin 2FA Credentials (generate password with: npx tsx scripts/generate-admin-password.ts)
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=bcrypt_hash_here
ADMIN_TELEGRAM_CHAT_ID=your_telegram_chat_id

# Cron Job Secret (for cleanup endpoints)
# Generate with: openssl rand -base64 32
CRON_SECRET=your_random_secret_here
